<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Стандартное ограничение: исключаем кэш из бэкапа. -->
        <exclude domain="file" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <!-- Перенос данных между устройствами без ограничений. -->
    </device-transfer>
</data-extraction-rules>